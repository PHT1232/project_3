{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Issuer": "StationeryManagementSystem",
    "Audience": "StationeryManagementSystem",
    "ExpiryHours": 8,
    "SigningKey": ""
  },
  "Seed": {
    "BootstrapAdminPassword": ""
  },
  "Elasticsearch": {
    "Uri": ""
  },
  "Features": {
    "AiAssistant": true
  },
  "Ai": {
    "MaxCatalogueItemsInPrompt": 40,
    "MaxUserTextLength": 1000,
    "RateLimitPerHour": 20
  },
  "Gemini": {
    "ApiKey": "",
    "Model": "gemini-3.5-flash-lite",
    "ThinkingLevel": "low",
    "BaseUrl": "https://generativelanguage.googleapis.com/v1beta/",
    "TimeoutSeconds": 10,
    "MaxRetries": 1,
    "MaxOutputTokens": 1024
  }
}
