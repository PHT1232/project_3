  <diagram id="dfd-l2-ai" name="Level 2 — 8.0 AI Assistant">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1587" pageHeight="1123" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="l2ct" value="DFD Level 2 — 8.0 AI Inventory Assistant" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="25" width="1000" height="30" as="geometry" /></mxCell>
        <mxCell id="l2cs" value="Decomposition of process 8.0. The reorder maths in 8.2 is deterministic and unit-testable; the LLM only turns the resulting table into a paragraph. If 8.3 times out or returns invalid JSON, 8.4 still delivers the table — the feature degrades, it never fails." style="text;html=1;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="58" width="1500" height="40" as="geometry" /></mxCell>
        <mxCell id="c_mgr2" value="Manager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="60" y="420" width="170" height="90" as="geometry" /></mxCell>
        <mxCell id="c_ai2" value="AI Service
(external LLM API)" style="rounded=0;dashed=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="920" y="120" width="190" height="80" as="geometry" /></mxCell>
        <mxCell id="c_p1" value="8.1
Gather inventory
context" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="420" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="c_p2" value="8.2
Compute reorder point
(deterministic)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="620" y="420" width="190" height="110" as="geometry" /></mxCell>
        <mxCell id="c_p3" value="8.3
Build prompt
&amp; call LLM" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="920" y="300" width="190" height="110" as="geometry" /></mxCell>
