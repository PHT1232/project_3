        <mxCell id="b14" value="Cumulative rows" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_p4" target="b_p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="890" y="655" /><mxPoint x="890" y="477" /></Array></mxGeometry></mxCell>
        <mxCell id="b16" value="Item names" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=0;exitDx=0;exitDy=0;entryX=0.8;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_d2" target="b_p5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1128" y="770" /></Array></mxGeometry></mxCell>
        <mxCell id="b17" value="Report rows (percentages sum to 100.00%)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=10;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="b_p5" target="b_mgr"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1035" y="350" /><mxPoint x="145" y="350" /></Array></mxGeometry></mxCell>
        <mxCell id="l2bp" value="&lt;b&gt;Note.&lt;/b&gt; Only requests in status Approved are counted — money is committed at approval, not at request. 7.2 must compute the largest share as 100 − sum(others) so the percentages total exactly 100.00%; naïve rounding gives 99.99%. Unit cost comes from RequestItems.UnitCostSnapshot, not from the live catalogue, so past reports never change when a price is edited (§3.4). D2 is read for item &lt;i&gt;names&lt;/i&gt; only." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=10;" vertex="1" parent="1"><mxGeometry x="60" y="940" width="1100" height="110" as="geometry" /></mxCell>
