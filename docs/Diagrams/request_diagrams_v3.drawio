        <mxCell id="p3e3" value="No" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_g1" target="p3_x1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p3e4" value="Yes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_g1" target="p3_b2"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="272" y="327" /><mxPoint x="272" y="732" /></Array></mxGeometry></mxCell>
        <mxCell id="p3e5" value="Approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_b2" target="p3_b3"><mxGeometry relative="1" as="geometry" /></mxCell>
