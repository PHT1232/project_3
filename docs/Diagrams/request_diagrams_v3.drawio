  <diagram id="diag-approve" name="3 · Approval Decision">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3t" value="Diagram 3 · Approval Decision — Pending → Approved | Rejected" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1010" height="28" as="geometry" /></mxCell>
        <mxCell id="p3s" value="The approver has exactly two outcomes: approve or reject. Return-for-modification is out of scope by team decision, so a rejected request is terminal — the requestor raises a new one. Every guard is enforced server-side and independently tested (§M4); hiding a button in React is not authorisation. The two action flows meet at a merge node before the concurrency guard: one code path, one transaction. A red node is terminal — the API returns, nothing is written, and the request keeps its current status." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1090" height="44" as="geometry" /></mxCell>
        <mxCell id="p3pool" value="Decide a Pending Request" style="swimlane;html=1;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#5A5A5A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1090" height="700" as="geometry" /></mxCell>
        <mxCell id="p3lR" value="Requestor" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p3pool"><mxGeometry x="0" y="30" width="1090" height="130" as="geometry" /></mxCell>
        <mxCell id="p3lS" value="System — Application layer" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p3pool"><mxGeometry x="0" y="160" width="1090" height="400" as="geometry" /></mxCell>
        <mxCell id="p3lA" value="Approver — resolved superior" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p3pool"><mxGeometry x="0" y="560" width="1090" height="140" as="geometry" /></mxCell>
        <mxCell id="p3_rr1" value="Receive: Request Rejected&lt;br&gt;&lt;i&gt;terminal — raise a new request to try again&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lR"><mxGeometry x="855" y="15" width="205" height="45" as="geometry" /></mxCell>
        <mxCell id="p3_rr2" value="Receive: Request Approved&lt;br&gt;&lt;b&gt;→ Diagram 4&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lR"><mxGeometry x="855" y="68" width="205" height="45" as="geometry" /></mxCell>
        <mxCell id="p3_g1" value="Caller ==&lt;br&gt;Request.ApproverEmployeeNumber?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="75" y="20" width="150" height="95" as="geometry" /></mxCell>
        <mxCell id="p3_x1" value="404 Not Found&lt;br&gt;&lt;i&gt;not 403 — do not leak existence (§4.3)&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="75" y="128" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p3_x2" value="409 Conflict&lt;br&gt;&lt;i&gt;decided in another session — reload&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="250" y="130" width="140" height="50" as="geometry" /></mxCell>
        <mxCell id="p3_merge" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3C3C3C;fontSize=8;" vertex="1" parent="p3lS"><mxGeometry x="400" y="330" width="40" height="40" as="geometry" /></mxCell>
        <mxCell id="p3_g2" value="Status still Pending&lt;br&gt;AND&lt;br&gt;RowVersion current?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="530" y="20" width="150" height="95" as="geometry" /></mxCell>
        <mxCell id="p3_g5" value="Which&lt;br&gt;action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="720" y="20" width="110" height="95" as="geometry" /></mxCell>
        <mxCell id="p3_g3" value="DecisionComment&lt;br&gt;provided?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="860" y="15" width="130" height="90" as="geometry" /></mxCell>
        <mxCell id="p3_x3" value="400 — a comment is mandatory&lt;br&gt;on reject&lt;br&gt;&lt;i&gt;approver re-enters it&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="860" y="110" width="130" height="45" as="geometry" /></mxCell>
        <mxCell id="p3_g4" value="Stock ≥ quantity&lt;br&gt;on EVERY line?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="600" y="200" width="140" height="95" as="geometry" /></mxCell>
        <mxCell id="p3_x4" value="422 — insufficient stock&lt;br&gt;&lt;i&gt;nothing written · stays Pending · the approver may reject instead&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p3lS"><mxGeometry x="490" y="305" width="175" height="45" as="geometry" /></mxCell>
        <mxCell id="p3_txrr" value="&lt;b&gt;SINGLE DB TRANSACTION&lt;/b&gt;&lt;br&gt;1 · Status = Rejected&amp;nbsp; 2 · DecisionComment, DecidedAtUtc, Approver&amp;nbsp; 3 · INSERT RequestStatusHistory (Pending → Rejected)&amp;nbsp; 4 · NotifyBoth(RequestRejected)&lt;br&gt;&lt;i&gt;no stock movement — nothing was ever reserved&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p3lS"><mxGeometry x="760" y="160" width="320" height="95" as="geometry" /></mxCell>
        <mxCell id="p3_txap" value="&lt;b&gt;SINGLE DB TRANSACTION — all-or-nothing&lt;/b&gt;&lt;br&gt;1 · Decrement StationeryItems.QuantityAvailable per line&lt;br&gt;2 · INSERT StockTransactions (Issue, −qty, actor, RequestId)&lt;br&gt;3 · Status = Approved, DecidedAtUtc, Approver&lt;br&gt;4 · INSERT RequestStatusHistory (Pending → Approved)&lt;br&gt;5 · NotifyBoth(RequestApproved)&lt;br&gt;&lt;i&gt;A failure on step 3 of 5 must leave steps 1–2 unchanged — the rollback case tested in CI (§M4).&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p3lS"><mxGeometry x="760" y="275" width="320" height="120" as="geometry" /></mxCell>
        <mxCell id="p3_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="p3lA"><mxGeometry x="40" y="62" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="p3_b1" value="Open request from&lt;br&gt;Approvals Queue" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lA"><mxGeometry x="80" y="48" width="140" height="55" as="geometry" /></mxCell>
        <mxCell id="p3_b2" value="Approver&lt;br&gt;decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p3lA"><mxGeometry x="250" y="20" width="120" height="105" as="geometry" /></mxCell>
        <mxCell id="p3_b3" value="Approve" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lA"><mxGeometry x="400" y="25" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="p3_b4" value="Reject" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lA"><mxGeometry x="400" y="75" width="130" height="34" as="geometry" /></mxCell>
        <mxCell id="p3_b6" value="Receive: decision recorded" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p3lA"><mxGeometry x="760" y="45" width="175" height="55" as="geometry" /></mxCell>
        <mxCell id="p3e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p3_start" target="p3_b1"><mxGeometry relative="1" as="geometry" /></mxCell>
