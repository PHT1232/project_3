<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" type="device">
  <diagram id="diag-lifecycle" name="1 · Request Lifecycle (State Machine)">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1t" value="Diagram 1 · Request Lifecycle — State Machine" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="28" as="geometry" /></mxCell>
        <mxCell id="p1s" value="Stationery Management System · authoritative view of the request lifecycle. Seven statuses; a submitted request is never deleted — every exit is a status transition. Actor, guard and side-effects for each labelled transition T1–T8 are in the panels below." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1090" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_draft" value="Draft" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="170" width="150" height="55" as="geometry" /></mxCell>
        <mxCell id="p1_pending" value="Pending" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="170" width="150" height="55" as="geometry" /></mxCell>
        <mxCell id="p1_approved" value="Approved" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="660" y="170" width="150" height="55" as="geometry" /></mxCell>
        <mxCell id="p1_cancpend" value="CancellationPending" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880" y="170" width="210" height="55" as="geometry" /></mxCell>
        <mxCell id="p1_rejected" value="Rejected" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="150" y="315" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p1_withdrawn" value="Withdrawn" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="400" y="315" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p1_cancelled" value="Cancelled" style="rounded=1;arcSize=25;whiteSpace=wrap;html=1;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="930" y="315" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p1_init" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="78" y="184" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="p1_e_draft" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="95" y="100" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_e_draft_i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="101" y="106" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="p1_e_rej" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="208" y="400" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_e_rej_i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="214" y="406" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="p1_e_wd" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="458" y="400" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_e_wd_i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="464" y="406" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="p1_e_can" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="988" y="400" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_e_can_i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="994" y="406" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="p1_e_app" value="" style="ellipse;html=1;fillColor=none;strokeColor=#000000;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="718" y="315" width="34" height="34" as="geometry" /></mxCell>
        <mxCell id="p1_e_app_i" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="724" y="321" width="22" height="22" as="geometry" /></mxCell>
        <mxCell id="p1e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_init" target="p1_draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e2" value="T1  submit" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_draft" target="p1_pending"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e3" value="T8  delete draft" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.2;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_draft" target="p1_e_draft"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e4" value="T2  approve" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_pending" target="p1_approved"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e5" value="T3  reject" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.15;exitY=1;exitDx=0;exitDy=0;entryX=0.85;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_pending" target="p1_rejected"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e7" value="T4  withdraw" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_pending" target="p1_withdrawn"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e10" value="T5  request cancellation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_approved" target="p1_cancpend"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e11" value="T6  approve cancellation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.6;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_cancpend" target="p1_cancelled"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e12" value="T7  refuse cancellation" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_cancpend" target="p1_approved"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="932" y="128" /><mxPoint x="750" y="128" /></Array></mxGeometry></mxCell>
        <mxCell id="p1e13" value="closed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_approved" target="p1_e_app"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_rejected" target="p1_e_rej"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_withdrawn" target="p1_e_wd"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1e16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="p1_cancelled" target="p1_e_can"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p1_panelL" value="&lt;b&gt;Transition rules — actor · guard · side-effects&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;T1 submit&lt;/b&gt; — owner. Guard: ≥ 1 line item · RequiredByDate ≥ today · total ≤ MaxAmountPerRequest · total ≤ (MaxAmountPerMonth − month-to-date spend) · superior resolved from hierarchy. Effects: snapshot UnitCostSnapshot per line, write RequestStatusHistory, NotifyBoth. → &lt;b&gt;Diagram 2&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;T2 approve&lt;/b&gt; — the listed approver only (else 404). Guard: stock ≥ quantity on every line · RowVersion current (else 409). Effects, one transaction: decrement QuantityAvailable → StockTransactions(Issue) → Status, DecidedAtUtc, Approver → history → NotifyBoth. → &lt;b&gt;Diagram 3&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;T3 reject&lt;/b&gt; — listed approver. Guard: DecisionComment required (else 400). Effects: history, NotifyBoth. &lt;b&gt;Reject is terminal&lt;/b&gt; — there is no return-for-modification path; to change a rejected request the requestor raises a new one.&lt;br&gt;&lt;br&gt;&lt;b&gt;T4 withdraw&lt;/b&gt; — owner. Guard: status still Pending (else 409). Effects: history, NotifyBoth.&lt;br&gt;&lt;br&gt;&lt;b&gt;T5 request cancellation&lt;/b&gt; — owner. Guard: status Approved. Effects: history, NotifyBoth. → &lt;b&gt;Diagram 4&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="535" height="300" as="geometry" /></mxCell>
        <mxCell id="p1_panelR" value="&lt;b&gt;Transition rules (continued)&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;T6 approve cancellation&lt;/b&gt; — listed approver. Effects, one transaction: StockTransactions(Adjustment, +qty) → recompute QuantityAvailable → Status = Cancelled → history → NotifyBoth.&lt;br&gt;&lt;br&gt;&lt;b&gt;T7 refuse cancellation&lt;/b&gt; — listed approver. Status returns to Approved, stock untouched. Effects: history, NotifyBoth.&lt;br&gt;&lt;br&gt;&lt;b&gt;T8 delete draft&lt;/b&gt; — owner. Draft is the only state whose row may be removed; every other exit is a status transition — never DELETE a submitted request.&lt;br&gt;&lt;br&gt;&lt;b&gt;NotifyBoth(event)&lt;/b&gt; writes two Notifications rows — the requestor and the approver — inside the same transaction as the status change (§M4). Six triggers: submitted · approved · rejected · withdrawn · cancelled · &lt;i&gt;password changed&lt;/i&gt; — the last lives in AuthService, outside this lifecycle.&lt;br&gt;&lt;br&gt;&lt;b&gt;SCOPE — out of scope by team decision:&lt;/b&gt; ReturnedForModification and the return-for-modification branch. &lt;b&gt;Seven statuses; the approver has two outcomes&lt;/b&gt; (approve, reject). §3.6, §4.2 (&lt;i&gt;POST /requests/{id}/return&lt;/i&gt;) and task T4.3 of the plan still describe the returned branch and must be updated to match." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#B0B0B0;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingRight=10;fontSize=9;" vertex="1" parent="1"><mxGeometry x="595" y="470" width="535" height="300" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="diag-submit" name="2 · Submission &amp; Validation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2t" value="Diagram 2 · Submission &amp; Validation — Draft → Pending" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="900" height="28" as="geometry" /></mxCell>
        <mxCell id="p2s" value="Server-side validation of transition T1. Unit costs are snapshotted by the server, never by the client (§3.4). Both eligibility caps are enforced: MaxAmountPerRequest and MaxAmountPerMonth − month-to-date spend. A failed validation writes nothing and leaves the request in Draft — the user corrects it and submits again. There is no return-for-modification path into this diagram: a submitted request is either approved or rejected." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1090" height="44" as="geometry" /></mxCell>
        <mxCell id="p2pool" value="Submit Stationery Request" style="swimlane;html=1;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#5A5A5A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="96" width="1090" height="660" as="geometry" /></mxCell>
        <mxCell id="p2lR" value="Requestor" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p2pool"><mxGeometry x="0" y="30" width="1090" height="150" as="geometry" /></mxCell>
        <mxCell id="p2lS" value="System — Application layer" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p2pool"><mxGeometry x="0" y="180" width="1090" height="350" as="geometry" /></mxCell>
        <mxCell id="p2lA" value="Approver — resolved superior" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p2pool"><mxGeometry x="0" y="530" width="1090" height="130" as="geometry" /></mxCell>
        <mxCell id="p2_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="p2lR"><mxGeometry x="50" y="60" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="p2_r1" value="Create / edit request lines&lt;br&gt;&lt;i&gt;status: Draft&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lR"><mxGeometry x="90" y="45" width="175" height="60" as="geometry" /></mxCell>
        <mxCell id="p2_r2" value="Click &amp;#39;Submit Request&amp;#39;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lR"><mxGeometry x="285" y="50" width="130" height="50" as="geometry" /></mxCell>
        <mxCell id="p2_r3" value="Receive: Request Submitted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lR"><mxGeometry x="870" y="45" width="190" height="55" as="geometry" /></mxCell>
        <mxCell id="p2_s1" value="Snapshot UnitCostSnapshot per line&lt;br&gt;Total = Σ (qty × UnitCostSnapshot)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lS"><mxGeometry x="285" y="20" width="175" height="60" as="geometry" /></mxCell>
        <mxCell id="p2_d1" value="≥ 1 line item&lt;br&gt;AND&lt;br&gt;RequiredByDate ≥ today?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="485" y="10" width="165" height="95" as="geometry" /></mxCell>
        <mxCell id="p2_d2" value="Total ≤ MaxAmountPerRequest&lt;br&gt;AND ≤ monthly remaining?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="675" y="10" width="180" height="95" as="geometry" /></mxCell>
        <mxCell id="p2_d3" value="Superior resolved&lt;br&gt;from hierarchy?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="875" y="10" width="165" height="95" as="geometry" /></mxCell>
        <mxCell id="p2_x1" value="400 — no line items,&lt;br&gt;or date in the past" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="485" y="120" width="165" height="48" as="geometry" /></mxCell>
        <mxCell id="p2_x2" value="422 — exceeds eligibility&lt;br&gt;&lt;i&gt;message names the limit and the overage&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="675" y="120" width="180" height="48" as="geometry" /></mxCell>
        <mxCell id="p2_x3" value="400 — no superior resolved&lt;br&gt;&lt;i&gt;the MD cannot raise a request&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="875" y="120" width="165" height="48" as="geometry" /></mxCell>
        <mxCell id="p2_ret" value="Return errors to the client&lt;br&gt;&lt;i&gt;nothing written · status unchanged&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p2lS"><mxGeometry x="400" y="200" width="215" height="55" as="geometry" /></mxCell>
        <mxCell id="p2_tx" value="&lt;b&gt;SINGLE DB TRANSACTION&lt;/b&gt;&lt;br&gt;1 · Status = Pending&lt;br&gt;2 · ApproverEmployeeNumber = resolved superior&lt;br&gt;3 · INSERT RequestStatusHistory (Draft → Pending, actor, UTC)&lt;br&gt;4 · NotifyBoth(RequestSubmitted) — 2 Notifications rows&lt;br&gt;&lt;i&gt;all-or-nothing: any failure rolls the whole set back&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p2lS"><mxGeometry x="760" y="190" width="300" height="135" as="geometry" /></mxCell>
        <mxCell id="p2_a1" value="Receive: New Pending Request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lA"><mxGeometry x="760" y="35" width="180" height="55" as="geometry" /></mxCell>
        <mxCell id="p2_a2" value="Appears in Approvals Queue&lt;br&gt;&lt;b&gt;→ Diagram 3&lt;/b&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p2lA"><mxGeometry x="960" y="35" width="100" height="55" as="geometry" /></mxCell>
        <mxCell id="p2e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_start" target="p2_r1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="p2e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p2_r1" target="p2_r2"><mxGeometry relative="1" as="geometry" /></mxCell>
