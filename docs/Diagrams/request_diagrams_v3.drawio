  <diagram id="diag-cancel" name="4 · Two-Step Cancellation">
    <mxGraphModel dx="1422" dy="794" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4t" value="Diagram 4 · Two-Step Cancellation — Approved → CancellationPending → Cancelled" style="text;html=1;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="40" y="14" width="1010" height="28" as="geometry" /></mxCell>
        <mxCell id="p4s" value="Withdraw and Cancel are different operations: withdraw is unilateral on a Pending request, cancellation needs the superior&amp;#39;s second sign-off on an Approved one. §3.6 calls this out explicitly, and it is the requirement most often collapsed into a delete. A refusal returns the request to Approved rather than ending it. Both execution steps also notify the approver — NotifyBoth writes two rows." style="text;html=1;fontSize=10;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="44" width="1090" height="44" as="geometry" /></mxCell>
        <mxCell id="p4pool" value="Cancel an Approved Request" style="swimlane;html=1;horizontal=1;startSize=30;fillColor=#FFFFFF;strokeColor=#5A5A5A;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="1090" height="690" as="geometry" /></mxCell>
        <mxCell id="p4lR" value="Requestor" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p4pool"><mxGeometry x="0" y="30" width="1090" height="170" as="geometry" /></mxCell>
        <mxCell id="p4lS" value="System — Application layer" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p4pool"><mxGeometry x="0" y="200" width="1090" height="340" as="geometry" /></mxCell>
        <mxCell id="p4lA" value="Approver — resolved superior" style="swimlane;html=1;horizontal=0;startSize=30;fillColor=none;strokeColor=#5A5A5A;fontSize=11;fontStyle=1;" vertex="1" parent="p4pool"><mxGeometry x="0" y="540" width="1090" height="150" as="geometry" /></mxCell>
        <mxCell id="p4_start" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=none;" vertex="1" parent="p4lR"><mxGeometry x="45" y="44" width="26" height="26" as="geometry" /></mxCell>
        <mxCell id="p4_c1" value="Click &amp;#39;Request Cancellation&amp;#39;&lt;br&gt;&lt;i&gt;on an Approved request&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lR"><mxGeometry x="90" y="30" width="165" height="55" as="geometry" /></mxCell>
        <mxCell id="p4_c2" value="Receive: Cancellation Submitted" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lR"><mxGeometry x="330" y="25" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="p4_c4" value="Receive: Cancellation Refused&lt;br&gt;&lt;i&gt;status returns to Approved — the request is still live (Diagram 1, T7)&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lR"><mxGeometry x="330" y="95" width="215" height="65" as="geometry" /></mxCell>
        <mxCell id="p4_c3" value="Receive: Cancellation Approved" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lR"><mxGeometry x="800" y="55" width="200" height="50" as="geometry" /></mxCell>
        <mxCell id="p4_h1" value="Caller == requestor&lt;br&gt;AND&lt;br&gt;Status == Approved?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p4lS"><mxGeometry x="90" y="20" width="165" height="95" as="geometry" /></mxCell>
        <mxCell id="p4_y1" value="409 Conflict&lt;br&gt;&lt;i&gt;not an Approved request of yours&lt;/i&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p4lS"><mxGeometry x="90" y="128" width="165" height="50" as="geometry" /></mxCell>
        <mxCell id="p4_tx1" value="&lt;b&gt;SINGLE DB TRANSACTION&lt;/b&gt;&lt;br&gt;1 · Status = CancellationPending&lt;br&gt;2 · INSERT RequestStatusHistory&lt;br&gt;3 · NotifyBoth(CancellationRequested)&lt;br&gt;&lt;i&gt;stock is NOT touched yet&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p4lS"><mxGeometry x="300" y="20" width="215" height="110" as="geometry" /></mxCell>
        <mxCell id="p4_h2" value="Caller ==&lt;br&gt;listed approver?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p4lS"><mxGeometry x="570" y="20" width="150" height="95" as="geometry" /></mxCell>
        <mxCell id="p4_y2" value="404 Not Found" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#F8CECC;strokeColor=#B85450;fontSize=9;" vertex="1" parent="p4lS"><mxGeometry x="570" y="128" width="150" height="40" as="geometry" /></mxCell>
        <mxCell id="p4_note" value="&lt;b&gt;Why an Adjustment, not a reversal.&lt;/b&gt; Stock is restored by appending a NEW StockTransactions row (Adjustment, +qty). The original Issue rows are never deleted or edited — the ledger is append-only (§3.5), which is exactly what makes the M4 data-reversal script possible." style="shape=note;whiteSpace=wrap;html=1;size=16;fillColor=#FFF8E1;strokeColor=#D6B656;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;fontSize=9;" vertex="1" parent="p4lS"><mxGeometry x="760" y="15" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p4_tx2" value="&lt;b&gt;SINGLE DB TRANSACTION&lt;/b&gt;&lt;br&gt;1 · INSERT StockTransactions (Adjustment, +qty) per line&lt;br&gt;2 · Recompute QuantityAvailable from the ledger&lt;br&gt;3 · Status = Cancelled&lt;br&gt;4 · INSERT RequestStatusHistory (CancellationPending → Cancelled)&lt;br&gt;5 · NotifyBoth(CancellationApproved)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p4lS"><mxGeometry x="745" y="155" width="315" height="165" as="geometry" /></mxCell>
        <mxCell id="p4_tx3" value="&lt;b&gt;SINGLE DB TRANSACTION&lt;/b&gt;&lt;br&gt;1 · Status = Approved — stock untouched&lt;br&gt;2 · INSERT RequestStatusHistory (CancellationPending → Approved)&lt;br&gt;3 · NotifyBoth(CancellationRefused)" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 4;fillColor=#F3EFFB;strokeColor=#9673A6;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=6;fontSize=9;fontColor=#3B2E55;" vertex="1" parent="p4lS"><mxGeometry x="380" y="190" width="300" height="120" as="geometry" /></mxCell>
        <mxCell id="p4_d0" value="Receive: Cancellation Requested" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lA"><mxGeometry x="300" y="45" width="190" height="50" as="geometry" /></mxCell>
        <mxCell id="p4_d1" value="Open cancellation&lt;br&gt;request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lA"><mxGeometry x="560" y="45" width="150" height="50" as="geometry" /></mxCell>
        <mxCell id="p4_d2" value="Cancellation&lt;br&gt;decision" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=9;" vertex="1" parent="p4lA"><mxGeometry x="750" y="20" width="130" height="105" as="geometry" /></mxCell>
        <mxCell id="p4_d3" value="Approve cancellation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lA"><mxGeometry x="910" y="25" width="150" height="36" as="geometry" /></mxCell>
        <mxCell id="p4_d4" value="Refuse cancellation" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="p4lA"><mxGeometry x="910" y="72" width="150" height="36" as="geometry" /></mxCell>
        <mxCell id="p4e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jumpStyle=arc;jumpSize=8;endArrow=block;endFill=1;strokeColor=#3C3C3C;fontSize=9;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="p4_start" target="p4_c1"><mxGeometry relative="1" as="geometry" /></mxCell>
