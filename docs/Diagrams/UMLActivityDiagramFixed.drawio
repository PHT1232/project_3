<mxfile host="app.diagrams.net">
  <diagram name="Page-1" id="Ym2BWL7G9BkWCYiJDD8x">
    <mxGraphModel dx="1030" dy="567" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TD\n\n%% ==========================================\n%% SWIMLANE 1: REQUESTOR\n%% ==========================================\nsubgraph Requestor [\&quot;Swimlane: Requestor\&quot;]\n    REQ_START((● Start))\n    REQ_CREATE[\&quot;Create / Edit Request&lt;br/&gt;(Status: Draft)\&quot;]\n    REQ_SUBMIT[\&quot;Click &#39;Submit Request&#39;&lt;br/&gt;&lt;i&gt;[Unit costs snapshotted]&lt;/i&gt;\&quot;]\n    \n    REQ_PENDING_HUB{\&quot;Request in Pending State\&quot;}\n    REQ_DO_WITHDRAW[\&quot;Click &#39;Withdraw Request&#39;\&quot;]\n    \n    REQ_APPROVED_HUB{\&quot;Request in Approved State\&quot;}\n    REQ_DO_CANCEL[\&quot;Click &#39;Request Cancellation&#39;\&quot;]\n\n    REQ_NOTIF_SUBMIT[\&quot;Receive: Submission Confirmation\&quot;]\n    REQ_NOTIF_REJECT[\&quot;Receive: Request Rejected\&quot;]\n    REQ_NOTIF_APPROVE[\&quot;Receive: Request Approved\&quot;]\n    REQ_NOTIF_WITHDRAW[\&quot;Receive: Request Withdrawn\&quot;]\n    REQ_NOTIF_CANCEL_REQ[\&quot;Receive: Cancellation Submitted\&quot;]\n    REQ_NOTIF_CANCEL_APP[\&quot;Receive: Cancellation Approved\&quot;]\n    REQ_NOTIF_CANCEL_REF[\&quot;Receive: Cancellation Refused\&quot;]\nend\n\n%% ==========================================\n%% SWIMLANE 2: APPROVER\n%% ==========================================\nsubgraph Approver [\&quot;Swimlane: Approver\&quot;]\n    APP_REVIEW[\&quot;Review Pending Request\&quot;]\n    APP_DECISION{\&quot;Approver Decision\&quot;}\n    \n    APP_ACTION_APPROVE[\&quot;Select &#39;Approve&#39;\&quot;]\n    APP_ACTION_REJECT[\&quot;Select &#39;Reject&#39;\&quot;]\n    \n    APP_REVIEW_CANCEL[\&quot;Review Cancellation Request\&quot;]\n    APP_CANCEL_DECISION{\&quot;Cancellation Decision\&quot;}\n    APP_ACTION_CANCEL_APP[\&quot;Select &#39;Approve Cancellation&#39;\&quot;]\n    APP_ACTION_CANCEL_REF[\&quot;Select &#39;Refuse Cancellation&#39;\&quot;]\n\n    APP_NOTIF_SUBMIT[\&quot;Receive: New Pending Request\&quot;]\n    APP_NOTIF_STOCK_FAIL[\&quot;Alert: Insufficient Stock\&quot;]\n    APP_NOTIF_REJECT[\&quot;Receive: Rejection Recorded\&quot;]\n    APP_NOTIF_APPROVE[\&quot;Receive: Approval Recorded\&quot;]\n    APP_NOTIF_WITHDRAW[\&quot;Receive: Request Withdrawn by Requestor\&quot;]\n    APP_NOTIF_CANCEL_REQ[\&quot;Receive: Cancellation Requested\&quot;]\n    APP_NOTIF_CANCEL_APP[\&quot;Receive: Cancellation Finalized\&quot;]\n    APP_NOTIF_CANCEL_REF[\&quot;Receive: Cancellation Refusal Recorded\&quot;]\nend\n\n%% ==========================================\n%% SWIMLANE 3: SYSTEM\n%% ==========================================\nsubgraph System [\&quot;Swimlane: System\&quot;]\n    %% Validations\n    SYS_VAL_ITEMS{\&quot;Has ≥ 1 line item&lt;br/&gt;&amp; valid date?\&quot;}\n    SYS_ERR_ITEMS[\&quot;Error: Invalid items/date\&quot;]\n    \n    SYS_VAL_LIMIT{\&quot;Total cost ≤ &lt;br/&gt;eligibility threshold?\&quot;}\n    SYS_ERR_LIMIT[\&quot;Error: Exceeds limit\&quot;]\n    \n    SYS_VAL_SUPERIOR{\&quot;Superior resolved&lt;br/&gt;from hierarchy?\&quot;}\n    SYS_ERR_SUPERIOR[\&quot;Error: No superior resolved\&quot;]\n\n    SYS_SET_PENDING[\&quot;Set Status = Pending\&quot;]\n    \n    FORK_SUBMIT{{\&quot;Fork\&quot;}}\n    JOIN_SUBMIT{{\&quot;Join\&quot;}}\n\n    %% Approval Stock logic\n    SYS_CHECK_STOCK{\&quot;Stock available for&lt;br/&gt;ALL line items?\&quot;}\n    SYS_STOCK_REVERT[\&quot;Retain Status = Pending\&quot;]\n    \n    SYS_EXEC_APPROVE[\&quot;1. Decrement Stock&lt;br/&gt;2. Write Ledger&lt;br/&gt;3. Set Status = Approved\&quot;]\n    FORK_APPROVE{{\&quot;Fork\&quot;}}\n    JOIN_APPROVE{{\&quot;Join\&quot;}}\n\n    SYS_EXEC_REJECT[\&quot;Set Status = Rejected\&quot;]\n    FORK_REJECT{{\&quot;Fork\&quot;}}\n    JOIN_REJECT{{\&quot;Join\&quot;}}\n\n    %% Withdraw Logic\n    SYS_GUARD_WITHDRAW{\&quot;Status == Pending?\&quot;}\n    SYS_EXEC_WITHDRAW[\&quot;Set Status = Withdrawn\&quot;]\n    FORK_WITHDRAW{{\&quot;Fork\&quot;}}\n    JOIN_WITHDRAW{{\&quot;Join\&quot;}}\n\n    %% Cancel Request Logic\n    SYS_GUARD_CANCEL_REQ{\&quot;Status == Approved?\&quot;}\n    SYS_SET_CANCEL_PENDING[\&quot;Set Status = CancellationPending\&quot;]\n    FORK_CANCEL_REQ{{\&quot;Fork\&quot;}}\n    JOIN_CANCEL_REQ{{\&quot;Join\&quot;}}\n\n    %% Cancel Decision Logic\n    SYS_EXEC_CANCEL_APP[\&quot;1. Restore Stock (Ledger)&lt;br/&gt;2. Set Status = Cancelled\&quot;]\n    FORK_CANCEL_APP{{\&quot;Fork\&quot;}}\n    JOIN_CANCEL_APP{{\&quot;Join\&quot;}}\n\n    SYS_EXEC_CANCEL_REF[\&quot;Set Status = Approved&lt;br/&gt;(Stock unchanged)\&quot;]\n    FORK_CANCEL_REF{{\&quot;Fork\&quot;}}\n    JOIN_CANCEL_REF{{\&quot;Join\&quot;}}\n\n    %% End States\n    SYS_END_REJECTED(((◉ End: Rejected)))\n    SYS_END_WITHDRAWN(((◉ End: Withdrawn)))\n    SYS_END_CANCELLED(((◉ End: Cancelled)))\n    SYS_END_APPROVED(((◉ End: Approved)))\nend\n\n%% ==========================================\n%% CONNECTIONS\n%% ==========================================\n\nREQ_START --&gt; REQ_CREATE\nREQ_CREATE --&gt; REQ_SUBMIT\nREQ_SUBMIT --&gt; SYS_VAL_ITEMS\n\n%% Validation Chain\nSYS_VAL_ITEMS -- \&quot;No\&quot; --&gt; SYS_ERR_ITEMS\nSYS_ERR_ITEMS --&gt; REQ_CREATE\nSYS_VAL_ITEMS -- \&quot;Yes\&quot; --&gt; SYS_VAL_LIMIT\n\nSYS_VAL_LIMIT -- \&quot;No (Over limit)\&quot; --&gt; SYS_ERR_LIMIT\nSYS_ERR_LIMIT --&gt; REQ_CREATE\nSYS_VAL_LIMIT -- \&quot;Yes (Within limit)\&quot; --&gt; SYS_VAL_SUPERIOR\n\nSYS_VAL_SUPERIOR -- \&quot;No (Null)\&quot; --&gt; SYS_ERR_SUPERIOR\nSYS_ERR_SUPERIOR --&gt; REQ_CREATE\nSYS_VAL_SUPERIOR -- \&quot;Yes\&quot; --&gt; SYS_SET_PENDING\n\n%% Submit Notifications\nSYS_SET_PENDING --&gt; FORK_SUBMIT\nFORK_SUBMIT --&gt; REQ_NOTIF_SUBMIT\nFORK_SUBMIT --&gt; APP_NOTIF_SUBMIT\nREQ_NOTIF_SUBMIT --&gt; JOIN_SUBMIT\nAPP_NOTIF_SUBMIT --&gt; JOIN_SUBMIT\n\nJOIN_SUBMIT --&gt; REQ_PENDING_HUB\nJOIN_SUBMIT --&gt; APP_REVIEW\n\n%% Approver Flow\nAPP_REVIEW --&gt; APP_DECISION\nAPP_DECISION -- \&quot;Approve\&quot; --&gt; APP_ACTION_APPROVE\nAPP_DECISION -- \&quot;Reject\&quot; --&gt; APP_ACTION_REJECT\n\n%% Approve Branch\nAPP_ACTION_APPROVE --&gt; SYS_CHECK_STOCK\nSYS_CHECK_STOCK -- \&quot;No\&quot; --&gt; SYS_STOCK_REVERT\nSYS_STOCK_REVERT --&gt; APP_NOTIF_STOCK_FAIL\nAPP_NOTIF_STOCK_FAIL --&gt; APP_REVIEW\n\nSYS_CHECK_STOCK -- \&quot;Yes\&quot; --&gt; SYS_EXEC_APPROVE\nSYS_EXEC_APPROVE --&gt; FORK_APPROVE\nFORK_APPROVE --&gt; REQ_NOTIF_APPROVE\nFORK_APPROVE --&gt; APP_NOTIF_APPROVE\nREQ_NOTIF_APPROVE --&gt; JOIN_APPROVE\nAPP_NOTIF_APPROVE --&gt; JOIN_APPROVE\nJOIN_APPROVE --&gt; REQ_APPROVED_HUB\n\n%% Reject Branch\nAPP_ACTION_REJECT --&gt; SYS_EXEC_REJECT\nSYS_EXEC_REJECT --&gt; FORK_REJECT\nFORK_REJECT --&gt; REQ_NOTIF_REJECT\nFORK_REJECT --&gt; APP_NOTIF_REJECT\nREQ_NOTIF_REJECT --&gt; JOIN_REJECT\nAPP_NOTIF_REJECT --&gt; JOIN_REJECT\nJOIN_REJECT --&gt; SYS_END_REJECTED\n\n%% Withdraw Flow\nREQ_PENDING_HUB -- \&quot;[Status == Pending]\&quot; --&gt; REQ_DO_WITHDRAW\nREQ_DO_WITHDRAW --&gt; SYS_GUARD_WITHDRAW\nSYS_GUARD_WITHDRAW -- \&quot;Yes\&quot; --&gt; SYS_EXEC_WITHDRAW\nSYS_GUARD_WITHDRAW -- \&quot;No\&quot; --&gt; REQ_PENDING_HUB\nSYS_EXEC_WITHDRAW --&gt; FORK_WITHDRAW\nFORK_WITHDRAW --&gt; REQ_NOTIF_WITHDRAW\nFORK_WITHDRAW --&gt; APP_NOTIF_WITHDRAW\nREQ_NOTIF_WITHDRAW --&gt; JOIN_WITHDRAW\nAPP_NOTIF_WITHDRAW --&gt; JOIN_WITHDRAW\nJOIN_WITHDRAW --&gt; SYS_END_WITHDRAWN\n\n%% Cancel Flow (Requestor)\nREQ_APPROVED_HUB -- \&quot;[Status == Approved]\&quot; --&gt; REQ_DO_CANCEL\nREQ_APPROVED_HUB -- \&quot;No cancellation requested\&quot; --&gt; SYS_END_APPROVED\n\nREQ_DO_CANCEL --&gt; SYS_GUARD_CANCEL_REQ\nSYS_GUARD_CANCEL_REQ -- \&quot;Yes\&quot; --&gt; SYS_SET_CANCEL_PENDING\nSYS_GUARD_CANCEL_REQ -- \&quot;No\&quot; --&gt; REQ_APPROVED_HUB\n\nSYS_SET_CANCEL_PENDING --&gt; FORK_CANCEL_REQ\nFORK_CANCEL_REQ --&gt; REQ_NOTIF_CANCEL_REQ\nFORK_CANCEL_REQ --&gt; APP_NOTIF_CANCEL_REQ\nREQ_NOTIF_CANCEL_REQ --&gt; JOIN_CANCEL_REQ\nAPP_NOTIF_CANCEL_REQ --&gt; JOIN_CANCEL_REQ\nJOIN_CANCEL_REQ --&gt; APP_REVIEW_CANCEL\n\n%% Cancel Review Flow (Approver)\nAPP_REVIEW_CANCEL --&gt; APP_CANCEL_DECISION\nAPP_CANCEL_DECISION -- \&quot;Approve\&quot; --&gt; APP_ACTION_CANCEL_APP\nAPP_CANCEL_DECISION -- \&quot;Refuse\&quot; --&gt; APP_ACTION_CANCEL_REF\n\nAPP_ACTION_CANCEL_APP --&gt; SYS_EXEC_CANCEL_APP\nSYS_EXEC_CANCEL_APP --&gt; FORK_CANCEL_APP\nFORK_CANCEL_APP --&gt; REQ_NOTIF_CANCEL_APP\nFORK_CANCEL_APP --&gt; APP_NOTIF_CANCEL_APP\nREQ_NOTIF_CANCEL_APP --&gt; JOIN_CANCEL_APP\nAPP_NOTIF_CANCEL_APP --&gt; JOIN_CANCEL_APP\nJOIN_CANCEL_APP --&gt; SYS_END_CANCELLED\n\nAPP_ACTION_CANCEL_REF --&gt; SYS_EXEC_CANCEL_REF\nSYS_EXEC_CANCEL_REF --&gt; FORK_CANCEL_REF\nFORK_CANCEL_REF --&gt; REQ_NOTIF_CANCEL_REF\nFORK_CANCEL_REF --&gt; APP_NOTIF_CANCEL_REF\nREQ_NOTIF_CANCEL_REF --&gt; JOIN_CANCEL_REF\nAPP_NOTIF_CANCEL_REF --&gt; JOIN_CANCEL_REF\nJOIN_CANCEL_REF --&gt; REQ_APPROVED_HUB&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="asjpWxUIXe-pwj2AWKcI-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=10;" vertex="1">
            <mxGeometry as="geometry" />
