        <UserObject label="Receive: Cancellation Submitted" mermaidId="n:REQ_NOTIF_CANCEL_REQ" mermaidBaseStyle="html=1;whiteSpace=wrap;strokeWidth=1;fillColor=light-dark(#ECECFF,#1f2020);strokeColor=light-dark(#9370DB,#cccccc);fontColor=light-dark(#333333,#cccccc);fontFamily=Trebuchet MS,Verdana,Arial,sans-serif;fontSize=16;" mermaidBaseValue="Receive: Cancellation Submitted" id="asjpWxUIXe-pwj2AWKcI-14">
